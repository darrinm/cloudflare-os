{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "router",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-02",

  // Gatekeeper service bindings (GATEKEEPER_*) are added dynamically at deploy time — by the
  // deploy service for customer instances, from the release manifest's binding templates. Only
  // the static backend binding is checked in.
  "services": [
    {
      "binding": "WORKSHOP_BACKEND",
      "service": "workshop-backend"
    }
  ],

  // The router owns the public origin for customer instances, so it serves the frontend.
  // Everything but the hashed bundles under /assets runs through the worker: the API and
  // gatekeeper prefixes it routes, and every document, which it serves uncacheable (the HTML shell
  // names this deploy's bundles, and a cached copy outlived the deploy). Wrangler rejects listing
  // the API prefixes alongside "/*" as redundant, so the one wildcard carries them.
  "assets": {
    "directory": "../workshop-frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
